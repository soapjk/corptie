CORPTIE_CLOUD_ENV=production
CORPTIE_CLOUD_HOST=127.0.0.1
CORPTIE_CLOUD_PORT=4310
CORPTIE_CLOUD_DATABASE_PATH=/Volumes/T9/data/corptie-cloud/shared/data/cloud.sqlite
CORPTIE_CLOUD_PUBLIC_BASE_URL=https://corptie.llmay.cn
CORPTIE_CLOUD_AUTH_SECRET=replace-with-at-least-32-random-characters
CORPTIE_CLOUD_ADMIN_TOKEN=replace-with-at-least-32-random-characters
CORPTIE_CLOUD_TRUSTED_ORIGINS=https://corptie.llmay.cn,corptie://oauth
CORPTIE_CLOUD_LOG_LEVEL=info
CORPTIE_CLOUD_MAX_JSON_BYTES=65536
CORPTIE_CLOUD_RELAY_MAX_FRAME_BYTES=262144
CORPTIE_CLOUD_RELAY_MAX_QUEUED_BYTES=1048576
CORPTIE_CLOUD_RELAY_MAX_CONNECTIONS_PER_ACCOUNT=20
CORPTIE_CLOUD_RELAY_HEARTBEAT_MS=30000
CORPTIE_CLOUD_VERSION=replace-with-release-revision
CORPTIE_CLOUD_MAIL_MODE=smtp
CORPTIE_CLOUD_SMTP_HOST=replace-with-smtp-host
CORPTIE_CLOUD_SMTP_PORT=465
CORPTIE_CLOUD_SMTP_SECURE=true
CORPTIE_CLOUD_SMTP_USER=replace-with-smtp-user
CORPTIE_CLOUD_SMTP_PASS=replace-with-smtp-password
CORPTIE_CLOUD_SMTP_FROM='Corptie <no-reply@llmay.cn>'
# Set during deployment preflight to an existing directory on the Mac mini's
# internal disk and a separate 0600 key file. Never place either below CLOUD_ROOT.
CORPTIE_CLOUD_SECONDARY_BACKUP_DIR=/replace-with-internal-disk-backup-directory
CORPTIE_CLOUD_BACKUP_KEY_FILE=/replace-with-restricted-backup-key-file
