<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.corptie.cloud</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Volumes/T9/data/corptie-cloud/current/ops/run-cloud.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Volumes/T9/data/corptie-cloud/shared/logs/cloud.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Volumes/T9/data/corptie-cloud/shared/logs/cloud.stderr.log</string>
</dict>
</plist>
