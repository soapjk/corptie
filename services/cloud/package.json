{
  "name": "@corptie/cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "auth:schema:generate": "auth generate --config scripts/better-auth.config.ts --output auth-schema.sql",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.7",
    "better-auth": "1.7.7",
    "nodemailer": "10.0.13",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/nodemailer": "8.0.2",
    "@types/ws": "8.18.1",
    "auth": "1.7.7",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
