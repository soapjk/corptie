{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corptie.local/contracts/project-code-search-receipts/v4-run-v6",
  "title": "Corptie Project Code Search Receipt Contracts — Approved RunReceipt v6",
  "description": "Approved fixed successor to artifact:aa6c9c01-7a1a-45bb-9a2d-51b3ffca1516@1 (03e5985fcd33abc95c4d805b3e023390db48b18391a4e49cfb20c758fe2703cc). Only RunReceipt authority/schemaVersion is converged to the approved v6 contract; CleanupReceipt remains schemaVersion 4. RepositorySourceSnapshotReceipt, SearchReceipt, sourceFingerprint ownership, Startup/Snapshot fields, closed shapes, and the acyclic stage chain are unchanged.",
  "oneOf": [
    {
      "$ref": "#/$defs/RepositorySourceSnapshotReceipt"
    },
    {
      "$ref": "#/$defs/SearchReceipt"
    }
  ],
  "$defs": {
    "LowercaseHex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "GenericContractArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "version",
        "contentHash",
        "relation",
        "receiptType",
        "schemaVersion"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "pattern": "^artifact:[0-9a-f-]+$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "relation": {
          "const": "implementation_spec"
        },
        "receiptType": {
          "type": "string",
          "enum": [
            "RepositorySourceSnapshotReceipt",
            "SearchReceipt",
            "ToolsetValidationReceipt",
            "RunReceipt",
            "CleanupReceipt"
          ]
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "RepositorySourceSnapshotContractArtifactRef": {
