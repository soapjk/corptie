        "schemaVersion": {
          "const": 1
        },
        "resourceVersion": {
          "type": "integer",
          "minimum": 1
        },
        "artifactRef": {
          "$ref": "#/$defs/RepositorySourceSnapshotContractArtifactRef"
        },
        "startupBindingRef": {
          "$ref": "#/$defs/StartupBindingRef"
        },
        "workId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "logicalSessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "repositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "worktreeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sourceCommitOid": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
            },
            {
              "const": "UNBORN_COMMIT"
            }
          ]
        },
        "sourceTreeOid": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
            },
            {
              "const": "EMPTY_TREE"
            }
          ]
        },
        "dirtyOverlayRef": {
          "$ref": "#/$defs/DirtyOverlayRef"
        },
        "ignoreConfigRevisionRef": {
          "$ref": "#/$defs/IgnoreConfigRevisionRef"
        },
        "scopeRootHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "receiptHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "$comment": "receiptHash is lowercase hex SHA-256 of RFC 8785 canonical JSON of this object with receiptHash omitted. sourceFingerprint is lowercase hex SHA-256 of the separately frozen source-fingerprint/v2 RFC 8785 payload. artifactRef identifies this approved supporting implementation_spec as pinned by the consuming DependencyContractManifest."
    },
