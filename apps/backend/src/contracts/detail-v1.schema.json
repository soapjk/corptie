{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:corptie:detail:1",
  "title": "Corptie Detail v1 transport contract",
  "oneOf": [{"$ref": "#/definitions/Document"}, {"$ref": "#/definitions/Patch"}, {"$ref": "#/definitions/ActionRequest"}],
  "definitions": {
    "Id": {"type": "string", "minLength": 1, "maxLength": 512},
    "Revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "Text": {
      "type": "object", "required": ["fallback"],
      "properties": {"key": {"type": ["string", "null"], "maxLength": 256}, "fallback": {"type": "string", "maxLength": 4096},
        "parameters": {"type": ["object", "null"], "maxProperties": 16, "additionalProperties": {"type": "string", "maxLength": 1024}}}
    },
    "Node": {
      "type": "object", "required": ["id", "kind", "props", "children"],
      "properties": {"id": {"$ref": "#/definitions/Id"}, "kind": {"$ref": "#/definitions/Id"},
        "props": {"type": "object"}, "children": {"type": "array", "maxItems": 500, "uniqueItems": true, "items": {"$ref": "#/definitions/Id"}},
        "binding": {"type": ["string", "null"], "maxLength": 256, "pattern": "^[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)*$"}},
      "allOf": [{"if": {"properties": {"kind": {"enum": ["column", "row", "section", "text", "markdown", "divider", "disclosure"]}}},
        "then": {"properties": {"props": {"properties": {"text": {"$ref": "#/definitions/Text"}, "label": {"$ref": "#/definitions/Text"},
          "semantic": {"type": "string", "maxLength": 256}, "actionId": {"$ref": "#/definitions/Id"}}}}}}]
    },
    "Action": {
      "type": "object", "required": ["id", "kind", "operation", "label", "available"],
      "properties": {"id": {"$ref": "#/definitions/Id"}, "kind": {"$ref": "#/definitions/Id"}, "operation": {"$ref": "#/definitions/Id"},
        "label": {"$ref": "#/definitions/Text"}, "available": {"type": "boolean"}, "reason": {"$ref": "#/definitions/Text"},
        "target": {"type": "object", "required": ["resourceType", "id"], "properties": {"resourceType": {"$ref": "#/definitions/Id"}, "id": {"$ref": "#/definitions/Id"}}},
        "confirmation": {"type": "string", "enum": ["none", "required", "destructive"]},
        "expectedResourceRevision": {"type": "string", "minLength": 1, "maxLength": 256}}
    },
    "Card": {
      "type": "object", "required": ["id", "templateRevision", "dataRevision", "title", "semanticKind", "rootNodeId", "nodes", "data", "actions", "fallback"],
      "properties": {"id": {"$ref": "#/definitions/Id"}, "templateRevision": {"$ref": "#/definitions/Revision"},
        "dataRevision": {"type": "string", "minLength": 1, "maxLength": 256}, "title": {"$ref": "#/definitions/Text"},
        "semanticKind": {"$ref": "#/definitions/Id"}, "rootNodeId": {"$ref": "#/definitions/Id"},
        "nodes": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"$ref": "#/definitions/Node"}},
        "data": {"type": "object"}, "actions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/definitions/Action"}}, "fallback": {"$ref": "#/definitions/Text"}}
    },
    "Document": {
      "type": "object", "required": ["schemaVersion", "documentId", "sessionId", "generation", "revision", "cards", "order"],
      "properties": {"schemaVersion": {"const": 1}, "documentId": {"$ref": "#/definitions/Id"}, "sessionId": {"$ref": "#/definitions/Id"},
        "generation": {"$ref": "#/definitions/Id"}, "revision": {"$ref": "#/definitions/Revision"},
        "cards": {"type": "array", "maxItems": 30, "items": {"$ref": "#/definitions/Card"}},
        "order": {"type": "array", "maxItems": 30, "uniqueItems": true, "items": {"$ref": "#/definitions/Id"}}}
    },
    "Patch": {
      "type": "object", "required": ["documentId", "sessionId", "generation", "baseRevision", "revision", "upsertCards", "removeCardIds"],
      "properties": {"documentId": {"$ref": "#/definitions/Id"}, "sessionId": {"$ref": "#/definitions/Id"}, "generation": {"$ref": "#/definitions/Id"},
        "baseRevision": {"$ref": "#/definitions/Revision"}, "revision": {"$ref": "#/definitions/Revision"},
        "upsertCards": {"type": "array", "maxItems": 30, "items": {"$ref": "#/definitions/Card"}},
        "removeCardIds": {"type": "array", "maxItems": 30, "uniqueItems": true, "items": {"$ref": "#/definitions/Id"}},
        "order": {"type": "array", "maxItems": 30, "uniqueItems": true, "items": {"$ref": "#/definitions/Id"}}}
    },
    "ActionRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "documentId", "cardId", "actionId", "fields"],
      "properties": {"schemaVersion": {"const": 1}, "requestId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$"},
        "documentId": {"$ref": "#/definitions/Id"}, "cardId": {"$ref": "#/definitions/Id"}, "actionId": {"$ref": "#/definitions/Id"},
        "expectedResourceRevision": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}, "fields": {"type": "object", "maxProperties": 64}}
    }
  }
}
